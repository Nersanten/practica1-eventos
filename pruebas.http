### Antes de empezar: arranca el servidor con  nodemon index.js
### Lanza 1.1 y 1.2, copia el "_id" de cada recinto y pégalo abajo (sin comillas).
### Lanza 2.1, copia el "_id" del evento y pégalo en @idEvento. El resto ya los usa solos.

# @baseUrl = http://localhost:8080
@baseUrl = https://practica1-eventos.onrender.com
@idRecinto1 = 6afc42f5bf4bb3ab0fae6ddd
@idRecinto2 = 6afc43cbbf4bb3ab0fae6dde
@idEvento = 6afc488ebf4bb3ab0fae6df5

### ==============================================================================
### 1. RECINTOS (Creación, listados y consultas)
### ==============================================================================

### 1.1. Crear Recinto 1 (Barcelona)
POST {{baseUrl}}/recintos
Content-Type: application/json

{
  "nombre": "Palau Sant Jordi",
  "direccion": "Passeig Olímpic 5-7",
  "localidad": "Barcelona",
  "aforoMaximo": 17960
}

### 1.2. Crear Recinto 2 (Madrid)
POST {{baseUrl}}/recintos
Content-Type: application/json

{
  "nombre": "WiZink Center",
  "direccion": "Avenida Felipe II s/n",
  "localidad": "Madrid",
  "aforoMaximo": 17453
}

### 1.3. Listar todos los recintos
GET {{baseUrl}}/recintos

### 1.4. Buscar recinto por ID
GET {{baseUrl}}/recintos/{{idRecinto1}}

### 1.5. Buscar recintos por localidad
GET {{baseUrl}}/recintos/localidad/Barcelona


### ==============================================================================
### 2. EVENTOS (Creación, listados y actualización)
### ==============================================================================

### 2.1. Crear Evento Futuro (recinto: Palau Sant Jordi)
POST {{baseUrl}}/eventos
Content-Type: application/json

{
  "nombre": "Concierto Rock Fest 2027",
  "fecha": "2027-06-20T21:00:00.000Z",
  "recinto": "{{idRecinto1}}",
  "entradas": [
    {
      "tipo": "VIP",
      "precio": 120,
      "disponibles": 50
    },
    {
      "tipo": "General",
      "precio": 45,
      "disponibles": 500
    }
  ]
}

### 2.2. Crear Evento Pasado (recinto: WiZink Center)
POST {{baseUrl}}/eventos
Content-Type: application/json

{
  "nombre": "Festival Retro Pasado",
  "fecha": "2023-05-10T20:00:00.000Z",
  "recinto": "{{idRecinto2}}",
  "entradas": [
    {
      "tipo": "VIP",
      "precio": 90,
      "disponibles": 20
    },
    {
      "tipo": "General",
      "precio": 35,
      "disponibles": 200
    }
  ]
}

### 2.3. Listar todos los eventos (con populate de recinto)
GET {{baseUrl}}/eventos

### 2.4. Buscar evento por ID (con populate)
GET {{baseUrl}}/eventos/{{idEvento}}

### 2.5. Buscar eventos futuros por localidad del recinto
GET {{baseUrl}}/eventos/localidad/Barcelona

### 2.6. Actualizar evento por ID
PUT {{baseUrl}}/eventos/{{idEvento}}
Content-Type: application/json

{
  "nombre": "Concierto Rock Fest 2027 - Edición Ampliada",
  "fecha": "2027-06-21T21:30:00.000Z",
  "recinto": "{{idRecinto1}}",
  "entradas": [
    {
      "tipo": "VIP",
      "precio": 130,
      "disponibles": 60
    },
    {
      "tipo": "General",
      "precio": 50,
      "disponibles": 600
    }
  ]
}


### ==============================================================================
### 3. ENTRADAS (Consulta y venta/reducción de disponibles)
### ==============================================================================

### 3.1. Obtener precio y disponibles de entrada VIP
GET {{baseUrl}}/eventos/entradas/{{idEvento}}/VIP

### 3.2. Obtener precio y disponibles de entrada General
GET {{baseUrl}}/eventos/entradas/{{idEvento}}/General

### 3.3. Comprar/restar entradas (comprar 2 entradas VIP)
PUT {{baseUrl}}/eventos/entradas/{{idEvento}}/VIP/2


### ==============================================================================
### 4. PRUEBAS DE ERRORES Y VALIDACIONES
### ==============================================================================

### 4.1. Error: Buscar recinto con ID inexistente (debe devolver 404)
GET {{baseUrl}}/recintos/65f000000000000000000000

### 4.2. Error: Buscar recintos de localidad sin recintos (debe devolver 404)
GET {{baseUrl}}/recintos/localidad/LocalidadDesconocida

### 4.3. Error: Crear recinto incumpliendo validaciones (nombre < 5 caracteres, dirección < 10)
POST {{baseUrl}}/recintos
Content-Type: application/json

{
  "nombre": "Sala",
  "direccion": "Calle 1",
  "localidad": "ZG"
}

### 4.4. Error: Buscar evento con ID inexistente (debe devolver 404)
GET {{baseUrl}}/eventos/65f000000000000000000000

### 4.5. Error: Buscar eventos de localidad que solo tiene eventos pasados o sin eventos (debe devolver 404)
GET {{baseUrl}}/eventos/localidad/Madrid

### 4.6. Error: Crear evento con datos no válidos (precio negativo o entradas decimales)
POST {{baseUrl}}/eventos
Content-Type: application/json

{
  "nombre": "Evento Erróneo",
  "fecha": "2027-10-10T20:00:00.000Z",
  "recinto": "{{idRecinto1}}",
  "entradas": [
    {
      "tipo": "VIP",
      "precio": -10,
      "disponibles": 5.5
    }
  ]
}

### 4.7. Error: Obtener datos de tipo de entrada inexistente en evento (debe devolver 404)
GET {{baseUrl}}/eventos/entradas/{{idEvento}}/Platino

### 4.8. Error: Comprar más entradas de las disponibles (debe devolver 404)
PUT {{baseUrl}}/eventos/entradas/{{idEvento}}/VIP/99999

### 4.9. Error: Comprar cantidad no válida (0, negativa o no entera, debe devolver 404)
PUT {{baseUrl}}/eventos/entradas/{{idEvento}}/VIP/-3


### ==============================================================================
### 5. ELIMINACIÓN (DELETE al final)
### ==============================================================================

### 5.1. Eliminar evento por ID
DELETE {{baseUrl}}/eventos/{{idEvento}}

### 5.2. Error: Eliminar evento con ID ya eliminado o inexistente (debe devolver 404)
DELETE {{baseUrl}}/eventos/{{idEvento}}

### 5.3. Eliminar recinto por ID
DELETE {{baseUrl}}/recintos/{{idRecinto1}}

### 5.4. Error: Eliminar recinto con ID ya eliminado o inexistente (debe devolver 404)
DELETE {{baseUrl}}/recintos/{{idRecinto1}}
